{
  "name": "dsh-desktop",
  "version": "0.1.9",
  "description": "Windows desktop host for DeepSeek Harness",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "patch:dsh-picker": "node scripts/patch-dsh-directory-picker.mjs",
    "postinstall": "node scripts/patch-dsh-directory-picker.mjs",
    "runtime:install": "node scripts/install-dsh-runtime.mjs",
    "runtime:verify": "node scripts/verify-dsh-runtime.mjs",
    "update:dsh": "node scripts/update-dsh-runtime.mjs",
    "release:keys": "node scripts/generate-update-keys.mjs",
    "release:manifest": "node scripts/create-update-manifest.mjs",
    "build": "npm run patch:dsh-picker && tsc -p tsconfig.json",
    "clean": "node scripts/clean.mjs",
    "test:update": "npm run build && node scripts/test-update-manifest.mjs",
    "preview": "npm run build && node scripts/preview.mjs",
    "preview:safe": "npm run build && node scripts/preview.mjs --isolated",
    "preview:update": "npm run build && node scripts/preview.mjs --isolated --open-update-window",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && npm run runtime:verify && electron-builder --win msi --x64 && node scripts/verify-packaged-runtime.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@deepseek-ai/dsh": "0.1.0-rc.7",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3"
  },
  "desktopUpdate": {
    "repository": "seashapeland/dsh-desktop",
    "manifestUrl": "https://github.com/seashapeland/dsh-desktop/releases/latest/download/update.json",
    "publicKey": "",
    "publicKeyFile": "build/update-public-key.pem"
  },
  "dshRuntime": {
    "version": "0.1.0-rc.7"
  },
  "build": {
    "appId": "ai.deepseek.dshdesktop",
    "productName": "DSH Desktop",
    "icon": "build/icon.svg",
    "artifactName": "DSH-Desktop-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*",
      "build/update-public-key.pem",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime/node_modules",
        "to": "dsh-runtime/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "electronFuses": {
      "runAsNode": true
    },
    "asarUnpack": [
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "msi"
      ]
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "upgradeCode": "{E2E52BB9-6D8F-4E50-B7A1-58A78D322147}"
    }
  }
}
